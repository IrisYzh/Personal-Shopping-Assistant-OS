GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Claude, used by the three agents (default provider)
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_SUPERVISOR_MODEL=claude-haiku-5-5
CLAUDE_PRODUCT_MODEL=claude-haiku-5-5
CLAUDE_VERIFIER_MODEL=claude-sonnet-5-5

# Optional: the older Doubao setup. Set SHOPPING_AGENT_PROVIDER=ark to use it.
# SHOPPING_AGENT_PROVIDER=ark
# ARK_API_KEY=your_ark_api_key

# Browser extension backend (see docs/browser-extension.md)
# PILOT_KEYS=iris:long-random-key,friend1:another-random-key
# SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
# DIGEST_TO_EMAIL=your_email@gmail.com      # local mode only; pilot users type their address in Settings

# Pilot server (see docs/pilot-guide.md)
# PUBLIC_URL=https://your-app.onrender.com   # used for tracked email links
# TRACKING_SECRET=any-long-random-string     # signs email links; required on a public host
# ADMIN_KEY=another-long-random-string       # unlocks GET /metrics
# PILOT_TIMEZONE=America/Los_Angeles         # when daily and weekly summaries go out
# EMAIL_FROM_NAME=Shopping Assistant
